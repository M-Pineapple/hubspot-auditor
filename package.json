{
  "name": "hubspot-auditor",
  "version": "1.4.5",
  "mcpName": "io.github.M-Pineapple/hubspot-auditor",
  "description": "Read-only MCP server that audits a HubSpot portal and reports what works, what is broken, and what is missing.",
  "type": "module",
  "license": "MIT",
  "author": "M-Pineapple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-Pineapple/hubspot-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/M-Pineapple/hubspot-auditor/issues"
  },
  "homepage": "https://github.com/M-Pineapple/hubspot-auditor/blob/main/examples/example-report.md",
  "keywords": [
    "hubspot",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hubspot-api",
    "audit",
    "revops",
    "crm",
    "marketing-ops",
    "gdpr",
    "claude",
    "typescript"
  ],
  "main": "./dist/main.js",
  "bin": {
    "hubspot-auditor": "./dist/main.js"
  },
  "files": [
    "dist",
    "rules",
    "demo",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/main.js",
    "audit:demo": "node dist/main.js --demo --at 2026-10-12T00:00:00.000Z --out examples",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "js-yaml": "^4.1.0",
    "pdfkit": "^0.20.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.9.0"
  }
}
